# Copy to .env and change the password. .env is git-ignored.

# Postgres (standard libpq variable names: psycopg and dbt both read them)
PGHOST=localhost
PGPORT=5432
PGDATABASE=skillradar
PGUSER=skillradar
PGPASSWORD=change-me

# Ollama (runs on your host machine)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Leave empty for non-thinking models. For thinking models set true or false.
OLLAMA_THINK=
